+        v._gpu_storage = _gpu_storage;
@@ -137,2 +153,6 @@ private:
-    void* _buffer = nullptr;  // retained id<MTLBuffer> as void*
-    void* _data = nullptr;    // cached CPU-accessible pointer (shared memory on Apple Silicon)
+    struct GPUStorage {
+        void *buffer;
+        void *data;
+    };

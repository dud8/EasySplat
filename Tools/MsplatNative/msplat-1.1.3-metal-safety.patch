@@ -15,0 +16 @@
+#include <limits>
@@ -390,0 +392,13 @@ void msplat_drain_stage_times(std::vector<double> stage_times[], int max_stages,
+static constexpr int64_t kMaxTileElements = 2048;
+
+static uint32_t packed_intersection_capacity(int num_tiles) {
+    if (num_tiles <= 0) {
+        throw std::runtime_error("msplat: raster grid has no tiles");
+    }
+    const uint64_t capacity =
+        static_cast<uint64_t>(num_tiles) * static_cast<uint64_t>(kMaxTileElements);
+    if (capacity > static_cast<uint64_t>(std::numeric_limits<int32_t>::max())) {
+        throw std::runtime_error("msplat: raster intersection capacity exceeds int32 offsets");
+    }
+    return static_cast<uint32_t>(capacity);
+}

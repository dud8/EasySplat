     float rw = 1.f / (p_hom.w + 1e-6f);
 
     float3 v_ndc = {0.5f * img_size.x * v_xy.x, 0.5f * img_size.y * v_xy.y, 0.0f};
+    // The pixel coordinate divides by the homogeneous w, so w carries a cotangent of
+    // its own: d(x/w)/dw = -x/w^2, and the same for y. Both projected coordinates

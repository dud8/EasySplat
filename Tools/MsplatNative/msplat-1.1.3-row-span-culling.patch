+kernel void count_exact_tile_intersections_kernel(
+    constant uint& num_points [[buffer(0)]],
+    constant float* xys [[buffer(1)]],
+    constant int* radii [[buffer(2)]],
+    constant float* aabb [[buffer(3)]],
+    constant float* conics [[buffer(4)]],
+    constant float* opacities [[buffer(5)]],
+    constant uint3& tile_bounds [[buffer(6)]],
+    constant uint2& image_size [[buffer(7)]],
+    constant uint& tile_culling_min_area [[buffer(8)]],
+    device int32_t* num_tiles_hit [[buffer(9)]],
+    device atomic_uint* overflow_flag [[buffer(10)]],
+    device atomic_uint* raster_stats [[buffer(11)]],
+    uint idx [[thread_position_in_grid]]
+) {
+    if (!exact_raster_enabled(overflow_flag, raster_stats) || idx >= num_points ||
+        tile_culling_min_area == 0) {
+        return;
+    }
+    if (radii[idx] <= 0) {
+        num_tiles_hit[idx] = 0;
+        return;
+    }
 
+    const float2 center = read_packed_float2(xys, idx);
+    uint2 tile_min, tile_max;
+    get_tile_bbox(
+        center, read_packed_float2(aabb, idx), (int3)tile_bounds,
+        tile_min, tile_max
+    );
+    const uint tile_area =
+        (tile_max.x - tile_min.x) * (tile_max.y - tile_min.y);
+    if (tile_area < tile_culling_min_area) {
+        return;
+    }
+    float power_limit = 0.0f;
+    if (!opacity_power_limit(opacities[idx], power_limit)) {
+        num_tiles_hit[idx] = 0;
+        return;
+    }
+    const float3 conic = read_packed_float3(conics, idx);
+    int32_t count = 0;
+    for (uint tile_y = tile_min.y; tile_y < tile_max.y; ++tile_y) {
+        uint span_begin = 0;
+        uint span_end = 0;
+        if (ellipse_tile_row_span(
+                conic, center, tile_y, image_size, power_limit,
+                tile_min.x, tile_max.x, span_begin, span_end)) {
+            count += int32_t(span_end - span_begin);
+        }
+    }
+    num_tiles_hit[idx] = count;
+}

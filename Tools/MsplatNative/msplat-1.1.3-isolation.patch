+void msplat_prepare_isolation_view(
+    int num_points, MTensor &means3d, MTensor &scales, float glob_scale,
+    MTensor &quats, MTensor &viewmat, MTensor &projmat,
+    float fx, float fy, float cx, float cy,
+    unsigned img_height, unsigned img_width,
+    const std::tuple<int, int, int> tile_bounds, float clip_thresh,
+    unsigned degree, unsigned degrees_to_use, float cam_pos[3],
+    MTensor &features_dc, MTensor &features_rest,
+    MTensor &opacities, MTensor &background
+) {
+    const auto isGpuFloat = [](const MTensor &tensor) {
+        return tensor.isGpu() && tensor.dtype() == DType::Float32;
+    };
+    const uint64_t expectedTileColumns =
+        (static_cast<uint64_t>(img_width) + BLOCK_X - 1) / BLOCK_X;
+    const uint64_t expectedTileRows =
+        (static_cast<uint64_t>(img_height) + BLOCK_Y - 1) / BLOCK_Y;
+    if (num_points <= 0 || img_height == 0 || img_width == 0 ||
+        expectedTileColumns > static_cast<uint64_t>(std::numeric_limits<int>::max()) ||
+        expectedTileRows > static_cast<uint64_t>(std::numeric_limits<int>::max()) ||
+        expectedTileColumns * expectedTileRows >
+            static_cast<uint64_t>(std::numeric_limits<int>::max()) ||
+        std::get<0>(tile_bounds) != static_cast<int>(expectedTileColumns) ||
+        std::get<1>(tile_bounds) != static_cast<int>(expectedTileRows) ||
+        std::get<2>(tile_bounds) != 1 ||
+        !std::isfinite(glob_scale) || glob_scale <= 0 ||
+        !std::isfinite(fx) || !std::isfinite(fy) || fx <= 0 || fy <= 0 ||
+        !std::isfinite(cx) || !std::isfinite(cy) ||
+        !std::isfinite(clip_thresh) || clip_thresh <= 0 ||
+        cam_pos == nullptr || !std::isfinite(cam_pos[0]) ||
+        !std::isfinite(cam_pos[1]) || !std::isfinite(cam_pos[2]) ||
+        degree > 4 || degrees_to_use > degree ||
+        !isGpuFloat(means3d) ||
+        means3d.numel() != static_cast<int64_t>(num_points) * 3 ||
+        !isGpuFloat(scales) ||
+        scales.numel() != static_cast<int64_t>(num_points) * 3 ||
+        !isGpuFloat(quats) ||
+        quats.numel() != static_cast<int64_t>(num_points) * 4 ||
+        !isGpuFloat(viewmat) || viewmat.numel() != 16 ||
+        !isGpuFloat(projmat) || projmat.numel() != 16 ||
+        !isGpuFloat(features_dc) ||
+        features_dc.numel() != static_cast<int64_t>(num_points) * 3 ||
+        !isGpuFloat(features_rest) || features_rest.ndim() != 3 ||
+        features_rest.size(0) != num_points ||
+        features_rest.size(1) !=
+            static_cast<int64_t>((degree + 1) * (degree + 1) - 1) ||
+        features_rest.size(2) != 3 ||
+        !isGpuFloat(opacities) || opacities.numel() != num_points ||
+        !isGpuFloat(background) || background.numel() != 3) {
+        throw std::invalid_argument("msplat: isolation view inputs are invalid");
+    }
+    forward_pipeline(
+        num_points, means3d, scales, glob_scale,
+        quats, viewmat, projmat, fx, fy, cx, cy,
+        img_height, img_width, tile_bounds, clip_thresh,
+        degree, degrees_to_use, cam_pos, features_dc, features_rest,
+        opacities, background, true
+    );
+    g_isolation_prepared_view = IsolationPreparedView {
+        IsolationPreparedState::pendingSync,
+        num_points,
+        img_height,
+        img_width,
+    };
+}
+
+void msplat_lift_isolation_stripe(
+    unsigned img_height, unsigned img_width,
+    MTensor &mask_labels, MTensor &selected_gaussians, bool use_selection,
+    unsigned row_start, unsigned row_count,
+    MTensor &records, MTensor &record_counts, MTensor &soft_alpha,
+    MTensor &isolation_status
+) {
+    const uint64_t imagePixels =
+        static_cast<uint64_t>(img_height) * static_cast<uint64_t>(img_width);
+    const uint64_t stripePixels =
+        static_cast<uint64_t>(row_count) * static_cast<uint64_t>(img_width);
+    constexpr uint64_t recordBytesPerPixel =
+        MSPLAT_ISOLATION_RECORDS_PER_PIXEL *
+        sizeof(MsplatIsolationContributionRecord);
+    const bool recordBytesOverflow =
+        stripePixels > std::numeric_limits<uint64_t>::max() / recordBytesPerPixel;
+    const uint64_t recordBytes =
+        recordBytesOverflow ? 0 : stripePixels * recordBytesPerPixel;
+    if (g_isolation_prepared_view.state != IsolationPreparedState::ready ||
+        g_isolation_prepared_view.imageHeight != img_height ||
+        g_isolation_prepared_view.imageWidth != img_width ||
+        img_height == 0 || img_width == 0 ||
+        imagePixels > static_cast<uint64_t>(std::numeric_limits<int64_t>::max()) ||
+        stripePixels > static_cast<uint64_t>(std::numeric_limits<int64_t>::max()) ||
+        recordBytesOverflow ||
+        recordBytes > static_cast<uint64_t>(std::numeric_limits<size_t>::max()) ||
+        row_count == 0 || row_start >= img_height ||
+        row_count > img_height - row_start ||
+        !mask_labels.isGpu() || mask_labels.dtype() != DType::UInt8 ||
+        mask_labels.ndim() != 2 ||
+        mask_labels.size(0) != img_height || mask_labels.size(1) != img_width ||
+        mask_labels.numel() != static_cast<int64_t>(imagePixels) ||
+        !selected_gaussians.isGpu() ||
+        selected_gaussians.dtype() != DType::UInt8 ||
+        selected_gaussians.ndim() != 1 ||
+        selected_gaussians.numel() != g_isolation_prepared_view.numPoints ||
+        !records.isGpu() || records.dtype() != DType::UInt8 ||
+        records.nbytes() < static_cast<size_t>(recordBytes) ||
+        !record_counts.isGpu() || record_counts.dtype() != DType::Int32 ||
+        record_counts.numel() < static_cast<int64_t>(stripePixels) ||
+        !soft_alpha.isGpu() || soft_alpha.dtype() != DType::Float32 ||
+        soft_alpha.numel() < static_cast<int64_t>(stripePixels) ||
+        !isolation_status.isGpu() || isolation_status.dtype() != DType::Int32 ||
+        isolation_status.numel() != 1) {
+        throw std::invalid_argument("msplat: isolation stripe buffers are invalid");
+    }
+
+    MetalContext *ctx = get_global_context();
+    auto tileBounds = std::make_shared<std::array<uint32_t, 4>>(
+        std::array<uint32_t, 4> {
+            static_cast<uint32_t>(
+                (static_cast<uint64_t>(img_width) + BLOCK_X - 1) / BLOCK_X
+            ),
+            static_cast<uint32_t>(
+                (static_cast<uint64_t>(img_height) + BLOCK_Y - 1) / BLOCK_Y
+            ),
+            1u,
+            0xDEADu,
+        }
+    );
+    auto imageSize = std::make_shared<std::array<uint32_t, 4>>(
+        std::array<uint32_t, 4> {img_width, img_height, 1u, 0xDEADu}
+    );
+    const uint32_t useSelection = use_selection ? 1u : 0u;
+    const uint32_t rowStart = row_start;
+    const uint32_t rowCount = row_count;
+    const NSUInteger threadWidth = 16;
+    const NSUInteger threadHeight = std::min<NSUInteger>(
+        16,
+        ctx->isolation_lift_stripe_kernel_cpso.maxTotalThreadsPerThreadgroup /
+            threadWidth
+    );
+    if (threadHeight == 0) {
+        throw std::runtime_error(
+            "msplat: isolation kernel threadgroup limit is unsupported"
+        );
+    }
+    id<MTLCommandBuffer> commandBuffer = ctx->getCommandBuffer();
+    assert(commandBuffer && "Failed to retrieve isolation command buffer");
+    dispatch_sync(ctx->d_queue, ^(){
+        id<MTLBlitCommandEncoder> blit = [commandBuffer blitCommandEncoder];
+        [blit fillBuffer:isolation_status.buffer()
+                   range:NSMakeRange(0, isolation_status.nbytes())
+                   value:0];
+        [blit endEncoding];
+
+        id<MTLComputeCommandEncoder> encoder = [commandBuffer computeCommandEncoder];
+        assert(encoder && "Failed to create isolation compute encoder");
+        [encoder setComputePipelineState:ctx->isolation_lift_stripe_kernel_cpso];
+        [encoder setBytes:tileBounds->data() length:sizeof(*tileBounds) atIndex:0];

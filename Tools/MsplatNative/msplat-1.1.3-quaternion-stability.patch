+void msplat_quaternion_vjp_for_testing(
+    const float* quaternion,
+    const float* rotation_gradient,
+    float* quaternion_gradient
+) {
+    if (!quaternion || !rotation_gradient || !quaternion_gradient) {
+        throw std::invalid_argument("msplat: quaternion VJP oracle received a null buffer");
+    }
+    MetalContext* context = get_global_context();
+    MTensor device_quaternion = mtensor_empty(context->device, {4}, DType::Float32);
+    MTensor device_rotation_gradient = mtensor_empty(
+        context->device,
+        {9},
+        DType::Float32
+    );
+    MTensor device_quaternion_gradient = mtensor_empty(
+        context->device,
+        {4},
+        DType::Float32
+    );
+    std::memcpy(device_quaternion.data<float>(), quaternion, 4 * sizeof(float));
+    std::memcpy(
+        device_rotation_gradient.data<float>(),
+        rotation_gradient,
+        9 * sizeof(float)
+    );
+
+    id<MTLCommandBuffer> command_buffer = context->getCommandBuffer();
+    id<MTLComputeCommandEncoder> encoder = [command_buffer computeCommandEncoder];
+    [encoder setComputePipelineState:context->quaternion_vjp_for_testing_kernel_cpso];
+    ENC_BUF(encoder, device_quaternion, 0);
+    ENC_BUF(encoder, device_rotation_gradient, 1);
+    ENC_BUF(encoder, device_quaternion_gradient, 2);
+    [encoder dispatchThreads:MTLSizeMake(1, 1, 1)
+       threadsPerThreadgroup:MTLSizeMake(1, 1, 1)];
+    [encoder endEncoding];
+    context->syncCB();
+    std::memcpy(
+        quaternion_gradient,
+        device_quaternion_gradient.data<float>(),
+        4 * sizeof(float)
+    );
+}

+kernel void quaternion_vjp_for_testing_kernel(
+    constant float* quaternion [[buffer(0)]],
+    constant float* rotation_gradient [[buffer(1)]],
+    device float* quaternion_gradient [[buffer(2)]],
+    uint index [[thread_position_in_grid]]

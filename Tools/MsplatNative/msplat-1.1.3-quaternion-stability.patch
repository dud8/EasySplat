+        float3(rotation_gradient[0], rotation_gradient[1], rotation_gradient[2]),
+        float3(rotation_gradient[3], rotation_gradient[4], rotation_gradient[5]),
+        float3(rotation_gradient[6], rotation_gradient[7], rotation_gradient[8])
+    );
+    const float4 result = quat_to_rotmat_vjp(value, gradient);
+    quaternion_gradient[0] = result.x;
+    quaternion_gradient[1] = result.y;
+    quaternion_gradient[2] = result.z;
+    quaternion_gradient[3] = result.w;
+}

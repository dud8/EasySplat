diff --git a/core/metal/msplat_metal.mm b/core/metal/msplat_metal.mm
index 791e124..8e29764 100644
--- a/core/metal/msplat_metal.mm
+++ b/core/metal/msplat_metal.mm
@@ -407,0 +408,3 @@ struct FusedTensorCache {
+    MTensor loss_history;
+    std::vector<float> loss_normalizers;
+    int loss_history_capacity = 0;
@@ -480 +483,51 @@
-static FusedTensorCache g_tcache;
+static FusedTensorCache g_tcache;
+void msplat_record_last_loss(int slot, int capacity, float normalization) {
+    if (capacity <= 0 || slot < 0 || slot >= capacity ||
+        !std::isfinite(normalization) || normalization <= 0) {
+        throw std::runtime_error("msplat: invalid loss-history request");
+    }
+    if (!g_tcache.loss_sum.defined()) {
+        throw std::runtime_error("msplat: no training loss is available to record");
+    }
+    MetalContext* ctx = get_global_context();
+    if (g_tcache.loss_history_capacity != capacity) {
+        if (slot != 0) {
+            throw std::runtime_error("msplat: loss-history capacity changed mid-window");
+        }
+        g_tcache.loss_history = mtensor_empty(
+            ctx->device, {capacity}, DType::Float32
+        );
+        g_tcache.loss_normalizers.assign(capacity, 0);
+        g_tcache.loss_history_capacity = capacity;
+    }
+    g_tcache.loss_normalizers[slot] = normalization;
+
+    id<MTLBlitCommandEncoder> blit = [ctx->getCommandBuffer() blitCommandEncoder];
+    if (!blit) {
+        throw std::runtime_error("msplat: failed to create loss-history blit encoder");
+    }
+    [blit copyFromBuffer:g_tcache.loss_sum.buffer()
+            sourceOffset:0
+                toBuffer:g_tcache.loss_history.buffer()
+       destinationOffset:static_cast<NSUInteger>(slot) * sizeof(float)
+                    size:sizeof(float)];
+    [blit endEncoding];
+}
+
+void msplat_sync_loss_window(int count, float* output) {
+    if (count <= 0 || count > g_tcache.loss_history_capacity ||
+        !g_tcache.loss_history.defined() || output == nullptr) {
+        throw std::runtime_error("msplat: invalid completed loss window");
+    }
+    get_global_context()->syncCB();
+    const float* losses = g_tcache.loss_history.data<float>();
+    for (int index = 0; index < count; ++index) {
+        const double value = static_cast<double>(losses[index]) *
+            static_cast<double>(g_tcache.loss_normalizers[index]);
+        if (!std::isfinite(value)) {
+            throw std::runtime_error("msplat: loss window contains a non-finite value");
+        }
+        output[index] = static_cast<float>(value);
+    }
+}
+

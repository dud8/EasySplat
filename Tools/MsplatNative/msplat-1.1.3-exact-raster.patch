+    return atomic_load_explicit(overflow_flag, memory_order_relaxed) != 0u &&
+           atomic_load_explicit(&raster_stats[3], memory_order_relaxed) == 0u;
+}
+
+inline bool raster_execution_blocked(device atomic_uint* fatal_flag) {
+    return atomic_load_explicit(&fatal_flag[3], memory_order_relaxed) != 0u;

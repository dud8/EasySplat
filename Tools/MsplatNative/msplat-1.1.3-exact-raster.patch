+
+#define EXACT_PREFIX_TG_SIZE 1024
+#define EXACT_DISPATCH_PREFIX 0
+#define EXACT_DISPATCH_MAP 1
+#define EXACT_DISPATCH_ITEMS 2
+#define EXACT_DISPATCH_TILES 3
+#define EXACT_DISPATCH_SCAN 4
+
+inline void write_exact_dispatch(
+    device uint* arguments,
+    uint slot,
+    uint groups
+) {
+    uint offset = slot * 3;
+    arguments[offset] = groups;
+    arguments[offset + 1] = 1;
+    arguments[offset + 2] = 1;
+}

+kernel void prepare_exact_raster_kernel(
+    device atomic_uint* overflow_flag [[buffer(0)]],
+    device const uint64_t* cum_tiles_hit [[buffer(1)]],
+    constant uint& num_points [[buffer(2)]],
+    constant uint& capacity [[buffer(3)]],
+    device atomic_uint* raster_stats [[buffer(4)]],
+    device uint* dispatch_arguments [[buffer(5)]],
+    constant uint& num_tiles [[buffer(6)]],
+    constant uint& iteration [[buffer(7)]],
+    constant uint& camera_index [[buffer(8)]],
+    device atomic_uint* exact_timing_flags [[buffer(9)]],
+    constant uint& exact_timing_slot [[buffer(10)]],
+    uint idx [[thread_position_in_grid]]
+) {
+    if (idx != 0 || atomic_load_explicit(overflow_flag, memory_order_relaxed) == 0u ||
+        atomic_load_explicit(&raster_stats[3], memory_order_relaxed) != 0u) return;
+    uint64_t actual = num_points == 0 ? 0u : cum_tiles_hit[num_points - 1];
+    atomic_store_explicit(&raster_stats[2], (uint)(actual & 0xffffffffu), memory_order_relaxed);
+    atomic_store_explicit(&raster_stats[4], (uint)(actual >> 32), memory_order_relaxed);
+    if (actual > (uint64_t)capacity || actual > 0xffffffffULL) {
+        atomic_store_explicit(&raster_stats[5], iteration, memory_order_relaxed);
+        atomic_store_explicit(&raster_stats[6], camera_index, memory_order_relaxed);
+        atomic_store_explicit(&raster_stats[3], 1u, memory_order_relaxed);
+        return;
+    }
+    atomic_fetch_add_explicit(&raster_stats[0], 1u, memory_order_relaxed);
+    atomic_store_explicit(
+        &exact_timing_flags[exact_timing_slot],
+        1u,
+        memory_order_relaxed
+    );
+    write_exact_dispatch(
+        dispatch_arguments,
+        EXACT_DISPATCH_MAP,
+        (num_points + 255u) / 256u
+    );
+    write_exact_dispatch(
+        dispatch_arguments,
+        EXACT_DISPATCH_ITEMS,
+        ((uint)actual + 255u) / 256u
+    );
+    write_exact_dispatch(
+        dispatch_arguments,
+        EXACT_DISPATCH_TILES,
+        (num_tiles + 255u) / 256u
+    );
+    write_exact_dispatch(dispatch_arguments, EXACT_DISPATCH_SCAN, actual > 0 ? 1u : 0u);
+}

+void msplat_preflight_raster_memory(
+    int point_count,
+    int image_height,
+    int image_width,
+    int features_rest_bases
+) {
+    constexpr int tile_width = 16;
+    constexpr int tile_height = 16;
+    if (point_count <= 0 || image_height <= 0 || image_width <= 0 ||
+        features_rest_bases < 0) {
+        throw std::invalid_argument("msplat: raster preflight dimensions are invalid");
+    }
+    const uint64_t tile_columns =
+        (static_cast<uint64_t>(image_width) + tile_width - 1) / tile_width;
+    const uint64_t tile_rows =
+        (static_cast<uint64_t>(image_height) + tile_height - 1) / tile_height;
+    const uint64_t tile_count_u64 = checked_mul_u64(
+        tile_columns,
+        tile_rows,
+        "sizing raster tile grid"
+    );
+    if (tile_count_u64 > static_cast<uint64_t>(std::numeric_limits<int>::max())) {
+        throw std::runtime_error("msplat: raster tile grid exceeds native limits");
+    }
+    const int tile_count = static_cast<int>(tile_count_u64);
+    MetalContext* context = get_global_context();
+    const uint32_t capacity = fast_intersection_capacity(tile_count);
+    g_tcache.ensure_forward(
+        point_count,
+        capacity,
+        image_height,
+        image_width,
+        tile_count,
+        context->device
+    );
+    g_tcache.ensure_backward(point_count, features_rest_bases, context->device);

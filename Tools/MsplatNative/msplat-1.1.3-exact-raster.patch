+static uint32_t fast_intersection_capacity(int num_tiles) {
+    if (num_tiles <= 0) {
+        throw std::runtime_error("msplat: raster grid has no tiles");
+    }
+    const uint64_t capacity = checked_mul_u64(
+        static_cast<uint64_t>(num_tiles),
+        static_cast<uint64_t>(kMaxTileElements),
+        "sizing tile-local raster capacity"
+    );
+    if (capacity > std::numeric_limits<uint32_t>::max()) {
+        throw_raster_resource_limit_exceeded(
+            capacity,
+            std::numeric_limits<uint32_t>::max(),
+            0,
+            static_cast<uint64_t>(get_global_context()->device.currentAllocatedSize)
+        );
+    }
+    return static_cast<uint32_t>(capacity);
+}

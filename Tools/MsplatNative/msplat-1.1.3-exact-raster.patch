+kernel void exact_block_reduce_u64_kernel(
+    constant uint& count [[buffer(0)]],
+    device const int32_t* input [[buffer(1)]],
+    device uint64_t* block_totals [[buffer(2)]],
+    device atomic_uint* overflow_flag [[buffer(3)]],
+    uint group [[threadgroup_position_in_grid]],
+    uint lane [[thread_position_in_threadgroup]]
+) {
+    if (atomic_load_explicit(overflow_flag, memory_order_relaxed) == 0u) return;
+    threadgroup uint64_t values[EXACT_PREFIX_TG_SIZE];
+    uint index = group * EXACT_PREFIX_TG_SIZE + lane;
+    values[lane] = index < count ? (uint64_t)max(input[index], 0) : 0u;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint stride = EXACT_PREFIX_TG_SIZE / 2; stride > 0; stride >>= 1) {
+        if (lane < stride) values[lane] += values[lane + stride];
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (lane == 0) block_totals[group] = values[0];
+}
+
+kernel void exact_block_scan_propagate_u64_kernel(
+    constant uint& count [[buffer(0)]],
+    device const int32_t* input [[buffer(1)]],
+    device uint64_t* output [[buffer(2)]],
+    device const uint64_t* block_totals [[buffer(3)]],
+    device atomic_uint* overflow_flag [[buffer(4)]],
+    uint group [[threadgroup_position_in_grid]],
+    uint lane [[thread_position_in_threadgroup]]
+) {
+    if (atomic_load_explicit(overflow_flag, memory_order_relaxed) == 0u) return;
+    threadgroup uint64_t inclusive[EXACT_PREFIX_TG_SIZE];
+    uint index = group * EXACT_PREFIX_TG_SIZE + lane;
+    inclusive[lane] = index < count ? (uint64_t)max(input[index], 0) : 0u;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (lane == 0) {
+        uint64_t running = 0;
+        for (uint prior = 0; prior < group; ++prior) running += block_totals[prior];
+        for (uint offset = 0; offset < EXACT_PREFIX_TG_SIZE; ++offset) {
+            running += inclusive[offset];
+            inclusive[offset] = running;
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (index < count) output[index] = inclusive[lane];
+}

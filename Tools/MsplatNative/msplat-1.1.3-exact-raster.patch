+kernel void prepare_exact_dispatch_kernel(
+    device atomic_uint* overflow_flag [[buffer(0)]],
+    constant uint& num_points [[buffer(1)]],
+    device uint* dispatch_arguments [[buffer(2)]],
+    device atomic_uint* raster_stats [[buffer(3)]],
+    uint index [[thread_position_in_grid]]
+) {
+    if (index != 0) return;
+    for (uint slot = 0; slot < 5; ++slot) {
+        write_exact_dispatch(dispatch_arguments, slot, 0);
+    }
+    if (atomic_load_explicit(&raster_stats[3], memory_order_relaxed) == 0u &&
+        atomic_load_explicit(overflow_flag, memory_order_relaxed) != 0u) {
+        write_exact_dispatch(

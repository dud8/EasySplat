+static void attach_exact_raster_timing_handler() {
+    if (g_tcache.exact_capacity <= 1 || !g_tcache.raster_stats.defined()) return;
+    const uint64_t slot = g_raster_iteration % kExactRasterTimingSlotCount;
+    auto *timingFlags = g_tcache.exact_timing_flags.data<uint32_t>();
+    {
+        std::lock_guard<std::mutex> lock(g_exact_raster_metric_mutex);
+        if (g_pending_exact_raster_timing_handlers >= kExactRasterTimingSlotCount) {
+            throw std::runtime_error("msplat: exact raster timing queue exceeded its bound");
+        }
+        ++g_pending_exact_raster_timing_handlers;
+    }
+    timingFlags[slot] = 0;
+    id<MTLCommandBuffer> commandBuffer = get_global_context()->getCommandBuffer();
+    dispatch_group_enter(g_exact_raster_timing_group);
+    [commandBuffer addCompletedHandler:^(id<MTLCommandBuffer> completedCommandBuffer) {
+        {
+            std::lock_guard<std::mutex> lock(g_exact_raster_metric_mutex);
+            if (timingFlags[slot] != 0) {
+                const double started = completedCommandBuffer.GPUStartTime;
+                const double ended = completedCommandBuffer.GPUEndTime;
+                if (std::isfinite(started) && std::isfinite(ended) && ended > started) {
+                    g_exact_fallback_elapsed_seconds += ended - started;
+                } else {
+                    g_exact_raster_timing_invalid = true;
+                }
+            }
+            --g_pending_exact_raster_timing_handlers;
+        }
+        dispatch_group_leave(g_exact_raster_timing_group);
+    }];
+}

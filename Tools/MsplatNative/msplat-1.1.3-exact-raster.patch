+            std::to_string(stats.required_bytes) + " max_buffer_bytes=" +
+            std::to_string(stats.max_buffer_bytes)
+        );
+    }
+    if (stats.memory_budget_exceeded) {
+        throw std::runtime_error(
+            "raster_memory_budget_exceeded required_bytes=" +
+            std::to_string(stats.required_bytes) + " budget_bytes=" +
+            std::to_string(stats.budget_bytes)
+        );
+    }
+    if (stats.capacity_exceeded) {
+        throw std::runtime_error(
+            "raster_capacity_exceeded intersections=" +
+            std::to_string(stats.latest_intersection_count)
+        );
+    }

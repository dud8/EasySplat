+static void resize_exact_raster_capacity(
+    uint64_t intersection_count,
+    ExactRasterCapacityMode mode
+) {
+    if (intersection_count == 0 || intersection_count > std::numeric_limits<uint32_t>::max()) {
+        throw_raster_resource_limit_exceeded(
+            intersection_count,
+            std::numeric_limits<uint32_t>::max(),
+            intersection_count,
+            static_cast<uint64_t>(get_global_context()->device.currentAllocatedSize)
+        );
+    }
+    MetalContext *context = get_global_context();
+    msplat_gpu_sync_for_raster_replay();
+    if (g_exact_capacity_limit_for_testing != 0 &&
+        intersection_count > g_exact_capacity_limit_for_testing) {
+        throw_raster_resource_limit_exceeded(
+            checked_mul_u64(intersection_count, 12, "sizing exact test capacity"),
+            checked_mul_u64(g_exact_capacity_limit_for_testing, 12,
+                            "sizing exact test capacity"),
+            intersection_count,
+            static_cast<uint64_t>(context->device.currentAllocatedSize)
+        );
+    }
+
+    const bool growExact = intersection_count > static_cast<uint64_t>(g_tcache.exact_capacity);
+    const bool growPacked = intersection_count > static_cast<uint64_t>(g_tcache.packed_capacity);
+    if (!growExact && !growPacked) {
+#ifdef MSPLAT_ENABLE_RASTER_TEST_HOOKS
+        g_exact_execution_capacity_for_testing = 0;
+#endif
+        g_last_raster_allocation_bytes =
+            static_cast<uint64_t>(context->device.currentAllocatedSize);
+        g_last_raster_required_bytes = g_last_raster_allocation_bytes;
+        return;
+    }
+
+    const uint64_t allocated = static_cast<uint64_t>(context->device.currentAllocatedSize);
+    uint64_t released = g_tcache.exact_allocation_bytes();
+    if (growPacked) {
+        released = checked_add_u64(
+            released,
+            g_tcache.packed_allocation_bytes(),
+            "accounting replaced raster buffers"
+        );
+    }
+    const uint64_t trackedBytesBeforeGrowth = released;
+    const uint64_t allocationAfterRelease = allocated > released ? allocated - released : 0;
+
+    auto allocationRequests = [&](uint64_t requestedCapacity) {
+        const int64_t capacity = static_cast<int64_t>(requestedCapacity);
+        const int64_t radixCount = ((capacity + 255) / 256) * 256;
+        std::vector<std::pair<std::vector<int64_t>, DType>> requests {
+            {{capacity}, DType::Int64},
+            {{capacity}, DType::Int64},
+            {{capacity}, DType::Int32},
+            {{radixCount}, DType::Int32},
+        };
+        if (growPacked) {
+            requests.insert(requests.end(), {
+                {{capacity}, DType::Int32},
+                {{capacity, 3}, DType::Float32},
+                {{capacity, 3}, DType::Float32},
+                {{capacity, 3}, DType::Float32},
+            });
+        }
+        return requests;
+    };
+
+    const auto minimumRequests = allocationRequests(intersection_count);
+    validate_raster_allocation(
+        context->device,
+        minimumRequests,
+        allocationAfterRelease,
+        intersection_count
+    );
+
+    uint64_t targetCapacity = mode == ExactRasterCapacityMode::geometricGrowth
+        ? geometric_raster_capacity(intersection_count)
+        : intersection_count;
+    if (!growPacked) {
+        targetCapacity = std::min(
+            targetCapacity,
+            static_cast<uint64_t>(g_tcache.packed_capacity)
+        );
+    }
+    if (g_exact_capacity_limit_for_testing != 0) {
+        targetCapacity = std::min(targetCapacity, g_exact_capacity_limit_for_testing);
+    }
+    targetCapacity = std::max(targetCapacity, intersection_count);
+
+    auto requests = allocationRequests(targetCapacity);
+    if (targetCapacity > intersection_count &&
+        !raster_allocation_fits(context->device, requests, allocationAfterRelease)) {
+        targetCapacity = intersection_count;
+        requests = minimumRequests;
+    }
+    const uint64_t required = validate_raster_allocation(
+        context->device,
+        requests,
+        allocationAfterRelease,
+        intersection_count
+    );
+
+    g_tcache.release_exact_buffers();
+    if (growPacked) g_tcache.release_packed_buffers();
+    const int64_t capacity = static_cast<int64_t>(targetCapacity);
+    const int64_t radixCount = ((capacity + 255) / 256) * 256;
+    if (growPacked) {
+        g_tcache.packed_capacity = capacity;
+        g_tcache.gaussian_ids = mtensor_empty(context->device, {capacity}, DType::Int32);
+        g_tcache.packed_xy_opac = mtensor_empty(context->device, {capacity, 3}, DType::Float32);
+        g_tcache.packed_conic = mtensor_empty(context->device, {capacity, 3}, DType::Float32);
+        g_tcache.packed_rgb = mtensor_empty(context->device, {capacity, 3}, DType::Float32);
+    }
+    g_tcache.exact_capacity = capacity;
+    g_tcache.exact_isect_ids = mtensor_empty(context->device, {capacity}, DType::Int64);
+    g_tcache.exact_sort_keys_tmp = mtensor_empty(context->device, {capacity}, DType::Int64);
+    g_tcache.exact_sort_vals_tmp = mtensor_empty(context->device, {capacity}, DType::Int32);
+    g_tcache.exact_sort_counts = mtensor_empty(context->device, {radixCount}, DType::Int32);
+    uint64_t trackedBytesAfterGrowth = g_tcache.exact_allocation_bytes();
+    if (growPacked) {
+        trackedBytesAfterGrowth = checked_add_u64(
+            trackedBytesAfterGrowth,
+            g_tcache.packed_allocation_bytes(),
+            "accounting grown raster buffers"
+        );
+    }
+    if (trackedBytesAfterGrowth <= trackedBytesBeforeGrowth) {
+        throw std::runtime_error("msplat: exact raster growth did not add buffer capacity");
+    }
+    if (mode == ExactRasterCapacityMode::geometricGrowth) {
+        std::lock_guard<std::mutex> lock(g_exact_raster_metric_mutex);
+        const uint64_t nextGrowthCount = checked_add_u64(
+            g_exact_buffer_growth_count,
+            1,
+            "accounting exact raster buffer growths"
+        );
+        const uint64_t nextBytesAdded = checked_add_u64(
+            g_exact_buffer_bytes_added,
+            trackedBytesAfterGrowth - trackedBytesBeforeGrowth,
+            "accounting exact raster buffer growth"
+        );
+        g_exact_buffer_growth_count = nextGrowthCount;
+        g_exact_buffer_bytes_added = nextBytesAdded;
+        g_peak_exact_intersection_capacity = std::max(
+            g_peak_exact_intersection_capacity,
+            targetCapacity
+        );
+    }
+#ifdef MSPLAT_ENABLE_RASTER_TEST_HOOKS
+    g_exact_execution_capacity_for_testing = 0;
+#endif
+    g_last_raster_allocation_bytes = allocationAfterRelease;
+    g_last_raster_required_bytes = required;
+}

+static constexpr double kMinimumPlausibleGPUTimestampFrequencyHz = 1.0e6;
+static constexpr double kMaximumPlausibleGPUTimestampFrequencyHz = 10.0e9;
+// Metal resolves MTLCounterResultTimestamp into nanoseconds even when the
+// device's CPU/GPU reference timestamps use Mach absolute-time ticks.
+static constexpr double kResolvedCounterTimestampFrequencyHz = 1.0e9;
+static constexpr uint32_t kTimestampCalibrationMethodUnavailable = 0;
+static constexpr uint32_t kTimestampCalibrationMethodSamplePairs = 1;
+
+struct GPUTimestampCalibration {
+    double counterFrequencyHz = std::numeric_limits<double>::quiet_NaN();
+    double referenceFrequencyHz = std::numeric_limits<double>::quiet_NaN();
+    uint32_t sampleCount = 0;
+    uint32_t method = kTimestampCalibrationMethodUnavailable;
+};
+
+static bool plausibleGPUTimestampFrequency(double frequencyHz) {
+    return std::isfinite(frequencyHz) &&
+        frequencyHz >= kMinimumPlausibleGPUTimestampFrequencyHz &&
+        frequencyHz <= kMaximumPlausibleGPUTimestampFrequencyHz;
+}
+
+static double secondsFromGPUTicks(uint64_t ticks, double frequencyHz) {
+    if (!plausibleGPUTimestampFrequency(frequencyHz)) {
+        return std::numeric_limits<double>::quiet_NaN();
+    }
+    const double seconds = static_cast<double>(ticks) / frequencyHz;
+    return std::isfinite(seconds)
+        ? seconds
+        : std::numeric_limits<double>::quiet_NaN();
+}
+
+static bool coherentStageTiming(double stageSeconds, double commandBufferSeconds) {
+    if (!std::isfinite(stageSeconds) || !std::isfinite(commandBufferSeconds) ||
+        stageSeconds <= 0 || commandBufferSeconds <= 0) {
+        return false;
+    }
+    const double ratio = stageSeconds / commandBufferSeconds;
+    return ratio >= 0.25 && ratio <= 1.05;
+}
+
+static double frequencyFromTimestampPairs(
+    const uint64_t* cpuTimestamps,
+    const uint64_t* gpuTimestamps,
+    std::size_t sampleCount,
+    uint32_t timebaseNumer,
+    uint32_t timebaseDenom,
+    uint32_t* validIntervalCount
+) {
+    if (validIntervalCount) *validIntervalCount = 0;
+    if (!cpuTimestamps || !gpuTimestamps || sampleCount < 2 ||
+        timebaseNumer == 0 || timebaseDenom == 0) {
+        return std::numeric_limits<double>::quiet_NaN();
+    }
+
+    std::vector<double> frequencies;
+    frequencies.reserve(sampleCount - 1);
+    for (std::size_t index = 1; index < sampleCount; ++index) {
+        if (cpuTimestamps[index] <= cpuTimestamps[index - 1] ||
+            gpuTimestamps[index] <= gpuTimestamps[index - 1]) {
+            continue;
+        }
+        const uint64_t cpuDelta = cpuTimestamps[index] - cpuTimestamps[index - 1];
+        const uint64_t gpuDelta = gpuTimestamps[index] - gpuTimestamps[index - 1];
+        const double cpuSeconds = static_cast<double>(cpuDelta) *
+            static_cast<double>(timebaseNumer) /
+            static_cast<double>(timebaseDenom) / 1.0e9;
+        if (!std::isfinite(cpuSeconds) || cpuSeconds <= 0) continue;
+        const double frequencyHz = static_cast<double>(gpuDelta) / cpuSeconds;
+        if (plausibleGPUTimestampFrequency(frequencyHz)) {
+            frequencies.push_back(frequencyHz);
+        }
+    }
+    if (validIntervalCount) {
+        *validIntervalCount = static_cast<uint32_t>(frequencies.size());
+    }
+    if (frequencies.size() < 4) {
+        return std::numeric_limits<double>::quiet_NaN();
+    }
+
+    std::sort(frequencies.begin(), frequencies.end());
+    const double median = frequencies[frequencies.size() / 2];
+    if (!plausibleGPUTimestampFrequency(median)) {
+        return std::numeric_limits<double>::quiet_NaN();
+    }
+    const std::size_t consistent = static_cast<std::size_t>(std::count_if(
+        frequencies.begin(),
+        frequencies.end(),
+        [median](double frequencyHz) {
+            return std::abs(frequencyHz - median) / median <= 0.10;
+        }
+    ));
+    if (consistent * 4 < frequencies.size() * 3) {
+        return std::numeric_limits<double>::quiet_NaN();
+    }
+    return median;
+}
+
+static GPUTimestampCalibration calibrateGPUTimestamps(id<MTLDevice> device) {
+    constexpr std::size_t kSampleCount = 9;
+    constexpr double kSampleSpacingNanoseconds = 2.0e6;
+    std::array<uint64_t, kSampleCount> cpuTimestamps {};
+    std::array<uint64_t, kSampleCount> gpuTimestamps {};
+    mach_timebase_info_data_t timebase {};
+    if (mach_timebase_info(&timebase) != KERN_SUCCESS ||
+        timebase.numer == 0 || timebase.denom == 0) {
+        return {};
+    }
+    const uint64_t spacingTicks = std::max<uint64_t>(
+        1,
+        static_cast<uint64_t>(std::ceil(
+            kSampleSpacingNanoseconds * static_cast<double>(timebase.denom) /
+            static_cast<double>(timebase.numer)
+        ))
+    );
+    for (std::size_t index = 0; index < kSampleCount; ++index) {
+        MTLTimestamp cpuTimestamp = 0;
+        MTLTimestamp gpuTimestamp = 0;
+        [device sampleTimestamps:&cpuTimestamp gpuTimestamp:&gpuTimestamp];
+        cpuTimestamps[index] = static_cast<uint64_t>(cpuTimestamp);
+        gpuTimestamps[index] = static_cast<uint64_t>(gpuTimestamp);
+        if (index + 1 < kSampleCount) {
+            mach_wait_until(mach_absolute_time() + spacingTicks);
+        }
+    }
+    uint32_t validIntervalCount = 0;
+    const double frequencyHz = frequencyFromTimestampPairs(
+        cpuTimestamps.data(),
+        gpuTimestamps.data(),
+        cpuTimestamps.size(),
+        timebase.numer,
+        timebase.denom,
+        &validIntervalCount
+    );
+    if (!plausibleGPUTimestampFrequency(frequencyHz)) return {};
+    return {
+        kResolvedCounterTimestampFrequencyHz,
+        frequencyHz,
+        validIntervalCount,
+        kTimestampCalibrationMethodSamplePairs,
+    };
+}

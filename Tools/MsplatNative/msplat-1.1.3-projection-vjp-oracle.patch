+void msplat_projection_vjp_for_testing(
+    const float* mat,
+    const float* point,
+    unsigned int width,
+    unsigned int height,
+    const float* principal_point,
+    const float* v_xy,
+    float* out_pix,
+    float* out_grad
+) {

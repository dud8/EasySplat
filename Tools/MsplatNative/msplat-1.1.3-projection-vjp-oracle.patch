+    }
+    MetalContext* context = get_global_context();
+    MTensor d_mat = mtensor_empty(context->device, {16}, DType::Float32);
+    MTensor d_point = mtensor_empty(context->device, {3}, DType::Float32);
+    MTensor d_size = mtensor_empty(context->device, {2}, DType::Int32);
+    MTensor d_pp = mtensor_empty(context->device, {2}, DType::Float32);
+    MTensor d_vxy = mtensor_empty(context->device, {2}, DType::Float32);
+    MTensor d_pix = mtensor_empty(context->device, {2}, DType::Float32);
+    MTensor d_grad = mtensor_empty(context->device, {3}, DType::Float32);
+    std::memcpy(d_mat.data<float>(), mat, 16 * sizeof(float));
+    std::memcpy(d_point.data<float>(), point, 3 * sizeof(float));
+    std::memcpy(d_pp.data<float>(), principal_point, 2 * sizeof(float));
+    std::memcpy(d_vxy.data<float>(), v_xy, 2 * sizeof(float));
+    std::int32_t* size_ptr = d_size.data<std::int32_t>();
+    size_ptr[0] = static_cast<std::int32_t>(width);
+    size_ptr[1] = static_cast<std::int32_t>(height);
+
+    id<MTLCommandBuffer> command_buffer = context->getCommandBuffer();
+    id<MTLComputeCommandEncoder> encoder = [command_buffer computeCommandEncoder];
+    [encoder setComputePipelineState:context->projection_vjp_for_testing_kernel_cpso];
+    ENC_BUF(encoder, d_mat, 0);
+    ENC_BUF(encoder, d_point, 1);
+    ENC_BUF(encoder, d_size, 2);
+    ENC_BUF(encoder, d_pp, 3);
+    ENC_BUF(encoder, d_vxy, 4);
+    ENC_BUF(encoder, d_pix, 5);
+    ENC_BUF(encoder, d_grad, 6);

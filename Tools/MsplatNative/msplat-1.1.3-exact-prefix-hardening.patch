+void msplat_exact_prefix_sum_for_testing(
+    const int32_t* input,
+    uint32_t count,
+    uint64_t* output
+) {
+    if (count == 0) return;
+    if (!input || !output) {
+        throw std::invalid_argument("msplat: exact prefix oracle received a null buffer");
+    }
+
+    MetalContext *context = get_global_context();
+    const uint32_t block_count =
+        count / 1024u + static_cast<uint32_t>(count % 1024u != 0);
+    MTensor device_input = mtensor_empty(
+        context->device,
+        {static_cast<int64_t>(count)},
+        DType::Int32
+    );
+    MTensor device_output = mtensor_empty(
+        context->device,
+        {static_cast<int64_t>(count)},
+        DType::Int64
+    );
+    MTensor block_totals = mtensor_empty(
+        context->device,
+        {static_cast<int64_t>(block_count)},
+        DType::Int64
+    );
+    MTensor overflow = mtensor_zeros(context->device, {1}, DType::Int32);
+    std::memcpy(
+        device_input.data<int32_t>(),
+        input,
+        static_cast<size_t>(count) * sizeof(*input)
+    );
+    overflow.data<uint32_t>()[0] = 1;
+
+    id<MTLCommandBuffer> command_buffer = context->getCommandBuffer();
+    id<MTLComputeCommandEncoder> encoder = [command_buffer computeCommandEncoder];
+    [encoder setComputePipelineState:context->exact_block_reduce_u64_kernel_cpso];
+    ENC_SCALAR(encoder, count, 0); ENC_BUF(encoder, device_input, 1);
+    ENC_BUF(encoder, block_totals, 2); ENC_BUF(encoder, overflow, 3);
+    [encoder dispatchThreadgroups:MTLSizeMake(block_count, 1, 1)
+                threadsPerThreadgroup:MTLSizeMake(1024, 1, 1)];
+    [encoder memoryBarrierWithScope:MTLBarrierScopeBuffers];
+
+    [encoder setComputePipelineState:context->exact_block_offsets_u64_kernel_cpso];
+    ENC_SCALAR(encoder, count, 0); ENC_BUF(encoder, block_totals, 1);
+    ENC_BUF(encoder, overflow, 2);
+    [encoder dispatchThreads:MTLSizeMake(1, 1, 1)
+       threadsPerThreadgroup:MTLSizeMake(1, 1, 1)];
+    [encoder memoryBarrierWithScope:MTLBarrierScopeBuffers];
+
+    [encoder setComputePipelineState:context->exact_block_scan_propagate_u64_kernel_cpso];
+    ENC_SCALAR(encoder, count, 0); ENC_BUF(encoder, device_input, 1);
+    ENC_BUF(encoder, device_output, 2); ENC_BUF(encoder, block_totals, 3);
+    ENC_BUF(encoder, overflow, 4);
+    [encoder dispatchThreadgroups:MTLSizeMake(block_count, 1, 1)
+                threadsPerThreadgroup:MTLSizeMake(1024, 1, 1)];
+    [encoder endEncoding];
+    context->syncCB();
+
+    std::memcpy(
+        output,
+        device_output.data<uint64_t>(),
+        static_cast<size_t>(count) * sizeof(*output)
+    );
+}

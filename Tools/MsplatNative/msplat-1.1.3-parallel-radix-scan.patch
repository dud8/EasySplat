+void msplat_exact_radix_sort_for_testing(
+    const uint64_t* keys,
+    const uint32_t* values,
+    uint32_t count,
+    uint32_t capacity,
+    uint32_t tile_count,
+    uint64_t* sorted_keys,
+    uint32_t* sorted_values
+) {
+    if (count == 0) return;
+    if (!keys || !values || !sorted_keys || !sorted_values) {
+        throw std::invalid_argument("msplat: radix oracle received a null buffer");
+    }
+    if (tile_count == 0 || capacity < count) {
+        throw std::invalid_argument("msplat: radix oracle dimensions are invalid");
+    }
+
+    MetalContext *context = get_global_context();
+    const uint32_t block_count = capacity / 256u + (capacity % 256u != 0);
+    const int64_t count_capacity = static_cast<int64_t>(capacity);
+    const int64_t radix_count = static_cast<int64_t>(block_count) * 256;
+    MTensor keys_a = mtensor_empty(context->device, {count_capacity}, DType::Int64);
+    MTensor keys_b = mtensor_empty(context->device, {count_capacity}, DType::Int64);
+    MTensor values_a = mtensor_empty(context->device, {count_capacity}, DType::Int32);
+    MTensor values_b = mtensor_empty(context->device, {count_capacity}, DType::Int32);
+    MTensor counts = mtensor_empty(context->device, {radix_count}, DType::Int32);
+    MTensor digit_offsets = mtensor_empty(context->device, {256}, DType::Int32);
+    MTensor cumulative = mtensor_empty(context->device, {1}, DType::Int64);
+    MTensor overflow = mtensor_zeros(context->device, {1}, DType::Int32);
+    MTensor stats = mtensor_zeros(context->device, {kRasterStatCount}, DType::Int32);
+    const size_t key_bytes = static_cast<size_t>(capacity) * sizeof(*keys);
+    const size_t value_bytes = static_cast<size_t>(capacity) * sizeof(*values);
+    std::memcpy(keys_a.data<uint64_t>(), keys, key_bytes);
+    std::memcpy(keys_b.data<uint64_t>(), keys, key_bytes);
+    std::memcpy(
+        values_a.data<uint32_t>(),
+        values,
+        value_bytes
+    );
+    std::memcpy(values_b.data<uint32_t>(), values, value_bytes);
+    cumulative.data<uint64_t>()[0] = count;
+    overflow.data<uint32_t>()[0] = 1;
+
+    id<MTLCommandBuffer> command_buffer = context->getCommandBuffer();
+    id<MTLComputeCommandEncoder> encoder = [command_buffer computeCommandEncoder];
+    const uint32_t actual_blocks = count / 256u + (count % 256u != 0);
+    const uint32_t num_points = 1;
+    const uint32_t pass_count = exact_radix_pass_count(tile_count);
+    for (uint32_t pass = 0; pass < pass_count; ++pass) {
+        const uint32_t shift = pass * 8;
+        MTensor &keys_in = (pass % 2 == 0) ? keys_a : keys_b;
+        MTensor &values_in = (pass % 2 == 0) ? values_a : values_b;
+        MTensor &keys_out = (pass % 2 == 0) ? keys_b : keys_a;
+        MTensor &values_out = (pass % 2 == 0) ? values_b : values_a;
+
+        [encoder setComputePipelineState:context->radix_sort_histogram_kernel_cpso];
+        ENC_SCALAR(encoder, capacity, 0); ENC_BUF(encoder, keys_in, 1);
+        ENC_BUF(encoder, counts, 2); ENC_SCALAR(encoder, shift, 3);
+        ENC_BUF(encoder, cumulative, 4); ENC_SCALAR(encoder, num_points, 5);
+        ENC_BUF(encoder, overflow, 6); ENC_BUF(encoder, stats, 7);
+        [encoder dispatchThreadgroups:MTLSizeMake(actual_blocks, 1, 1)
+                    threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
+        [encoder memoryBarrierWithScope:MTLBarrierScopeBuffers];
+
+        [encoder setComputePipelineState:context->radix_sort_scan_blocks_kernel_cpso];
+        ENC_BUF(encoder, counts, 0); ENC_SCALAR(encoder, block_count, 1);
+        ENC_BUF(encoder, cumulative, 2); ENC_SCALAR(encoder, capacity, 3);
+        ENC_SCALAR(encoder, num_points, 4); ENC_BUF(encoder, overflow, 5);
+        ENC_BUF(encoder, stats, 6); ENC_BUF(encoder, digit_offsets, 7);
+        [encoder dispatchThreadgroups:MTLSizeMake(256, 1, 1)
+                    threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
+        [encoder memoryBarrierWithScope:MTLBarrierScopeBuffers];
+
+        [encoder setComputePipelineState:context->radix_sort_scan_digit_offsets_kernel_cpso];
+        ENC_BUF(encoder, digit_offsets, 0); ENC_BUF(encoder, overflow, 1);
+        ENC_BUF(encoder, stats, 2);
+        [encoder dispatchThreadgroups:MTLSizeMake(1, 1, 1)
+                    threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
+        [encoder memoryBarrierWithScope:MTLBarrierScopeBuffers];
+
+        [encoder setComputePipelineState:context->radix_sort_scatter_kernel_cpso];
+        ENC_SCALAR(encoder, capacity, 0); ENC_BUF(encoder, keys_in, 1);
+        ENC_BUF(encoder, values_in, 2); ENC_BUF(encoder, keys_out, 3);
+        ENC_BUF(encoder, values_out, 4); ENC_BUF(encoder, counts, 5);
+        ENC_SCALAR(encoder, shift, 6); ENC_BUF(encoder, cumulative, 7);
+        ENC_SCALAR(encoder, num_points, 8); ENC_BUF(encoder, overflow, 9);
+        ENC_BUF(encoder, stats, 10); ENC_BUF(encoder, digit_offsets, 11);
+        [encoder dispatchThreadgroups:MTLSizeMake(actual_blocks, 1, 1)
+                    threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
+        [encoder memoryBarrierWithScope:MTLBarrierScopeBuffers];

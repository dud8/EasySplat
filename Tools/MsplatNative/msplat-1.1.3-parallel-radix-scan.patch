+    MTensor &final_keys = (pass_count % 2 == 0) ? keys_a : keys_b;
+    MTensor &final_values = (pass_count % 2 == 0) ? values_a : values_b;
+    std::memcpy(sorted_keys, final_keys.data<uint64_t>(), key_bytes);
+    std::memcpy(sorted_values, final_values.data<uint32_t>(), value_bytes);

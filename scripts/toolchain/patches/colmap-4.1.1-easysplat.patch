+TEST_F(IncrementalMapperTest,
+       FindInitialImagePairDeterministicAcrossThreadCounts) {
+  struct SearchResult {
+    bool success = false;
+    image_t image_id1 = kInvalidImageId;
+    image_t image_id2 = kInvalidImageId;
+    Rigid3d cam2_from_cam1;
+    std::unordered_set<image_pair_t> attempted_pairs;
+  };
+
+  const std::unordered_map<image_t, size_t> no_initialization_trials;
+  const std::unordered_map<image_t, size_t> no_registrations;
+  const auto search = [&](const int num_threads,
+                          std::unordered_set<image_pair_t> attempted_pairs) {
+    IncrementalMapper::Options options = options_;
+    options.num_threads = num_threads;
+    SearchResult result;
+    result.attempted_pairs = std::move(attempted_pairs);
+    result.success = IncrementalMapperImpl::FindInitialImagePair(
+        options,
+        *cache_,
+        *reconstruction_,
+        no_initialization_trials,
+        no_registrations,
+        result.attempted_pairs,
+        result.image_id1,
+        result.image_id2,
+        result.cam2_from_cam1);
+    return result;
+  };
+
+  const CorrespondenceGraph& correspondence_graph =
+      *cache_->CorrespondenceGraph();
+  const std::vector<image_t> ranked_image_ids =
+      IncrementalMapperImpl::FindFirstInitialImage(options_,
+                                                   correspondence_graph,
+                                                   *reconstruction_,
+                                                   no_initialization_trials,
+                                                   no_registrations);
+  ASSERT_GE(ranked_image_ids.size(), 3);
+
+  // Treat every candidate owned by the highest-ranked image as a previously
+  // failed attempt. The next search must therefore reach a later-ranked task.
+  std::unordered_set<image_pair_t> failed_prefix;
+  for (const image_t image_id2 :
+       IncrementalMapperImpl::FindSecondInitialImage(options_,
+                                                     ranked_image_ids.front(),
+                                                     correspondence_graph,
+                                                     *reconstruction_,
+                                                     no_registrations)) {
+    failed_prefix.insert(
+        ImagePairToPairId(ranked_image_ids.front(), image_id2));
+  }
+  ASSERT_FALSE(failed_prefix.empty());
+
+  const SearchResult expected = search(/*num_threads=*/1, failed_prefix);
+  ASSERT_TRUE(expected.success);
+  EXPECT_NE(expected.image_id1, ranked_image_ids.front());
+  EXPECT_GT(expected.attempted_pairs.size(), failed_prefix.size());
+
+  for (const int num_threads : {1, 2, 4, -1}) {
+    for (size_t iteration = 0; iteration < 10; ++iteration) {
+      SCOPED_TRACE(::testing::Message()
+                   << "num_threads=" << num_threads
+                   << ", iteration=" << iteration);
+      const SearchResult actual = search(num_threads, failed_prefix);
+      ASSERT_TRUE(actual.success);
+      EXPECT_EQ(actual.image_id1, expected.image_id1);
+      EXPECT_EQ(actual.image_id2, expected.image_id2);
+      EXPECT_TRUE(actual.cam2_from_cam1.rotation().coeffs().isApprox(
+          expected.cam2_from_cam1.rotation().coeffs(), 1e-15));
+      EXPECT_TRUE(actual.cam2_from_cam1.translation().isApprox(
+          expected.cam2_from_cam1.translation(), 1e-15));
+      EXPECT_EQ(actual.attempted_pairs, expected.attempted_pairs);
+    }
+  }
+
+  // Pre-attempting every eligible pair must fail without mutating the set,
+  // independent of worker count.
+  std::unordered_set<image_pair_t> all_candidate_pairs;
+  for (const image_t image_id1 : ranked_image_ids) {
+    for (const image_t image_id2 :
+         IncrementalMapperImpl::FindSecondInitialImage(options_,
+                                                       image_id1,
+                                                       correspondence_graph,
+                                                       *reconstruction_,
+                                                       no_registrations)) {
+      all_candidate_pairs.insert(ImagePairToPairId(image_id1, image_id2));
+    }
+  }
+  ASSERT_FALSE(all_candidate_pairs.empty());
+
+  for (const int num_threads : {1, 2, 4, -1}) {
+    SCOPED_TRACE(::testing::Message() << "num_threads=" << num_threads);
+    const SearchResult exhausted = search(num_threads, all_candidate_pairs);
+    EXPECT_FALSE(exhausted.success);
+    EXPECT_EQ(exhausted.image_id1, kInvalidImageId);
+    EXPECT_EQ(exhausted.image_id2, kInvalidImageId);
+    EXPECT_EQ(exhausted.attempted_pairs, all_candidate_pairs);
+  }
+}

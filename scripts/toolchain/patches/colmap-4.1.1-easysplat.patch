+class DatabaseFileIdentity {
+ public:
+  explicit DatabaseFileIdentity(const std::filesystem::path& path)
+      : path_(path) {
+    descriptor_ =
+        open(path.string().c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (descriptor_ < 0) {
+      const int error = errno;
+      LOG(ERROR) << "EasySplat matches_importer requires a regular database "
+                    "file that is not a symbolic link: "
+                 << std::strerror(error);
+      return;
+    }
+    struct stat status;
+    if (fstat(descriptor_, &status) != 0) {
+      const int error = errno;
+      LOG(ERROR) << "EasySplat matches_importer could not bind the database "
+                    "file identity: "
+                 << std::strerror(error);
+      return;
+    }
+    if (!S_ISREG(status.st_mode)) {
+      LOG(ERROR) << "EasySplat matches_importer database path is not a regular "
+                    "file.";
+      return;
+    }
+    if (status.st_nlink != 1) {
+      LOG(ERROR) << "EasySplat matches_importer requires a database file with "
+                    "exactly one hard link.";
+      return;
+    }
+    device_ = status.st_dev;
+    inode_ = status.st_ino;
+    valid_ = true;
+  }
+
+  ~DatabaseFileIdentity() {
+    if (descriptor_ >= 0) {
+      close(descriptor_);
+    }
+  }
+
+  bool IsValid() const { return valid_; }
+
+  int descriptor() const { return descriptor_; }
+
+  bool MatchesPath() const {
+    if (!valid_) {
+      return false;
+    }
+    struct stat held_status;
+    struct stat path_status;
+    if (fstat(descriptor_, &held_status) != 0 ||
+        lstat(path_.string().c_str(), &path_status) != 0 ||
+        !S_ISREG(held_status.st_mode) || !S_ISREG(path_status.st_mode) ||
+        held_status.st_nlink != 1 || path_status.st_nlink != 1 ||
+        held_status.st_dev != device_ || held_status.st_ino != inode_ ||
+        path_status.st_dev != device_ || path_status.st_ino != inode_) {
+      LOG(ERROR) << "EasySplat matches_importer database path changed while "
+                    "the job owned it.";
+      return false;
+    }
+    return true;
+  }
+
+ private:
+  const std::filesystem::path path_;
+  int descriptor_ = -1;
+  dev_t device_ = 0;
+  ino_t inode_ = 0;
+  bool valid_ = false;
+};
+
+class ImporterDatabaseTransaction {
+ public:
+  explicit ImporterDatabaseTransaction(Database& database)
+      : database_(database) {
+    database_.BeginImmediateTransaction();
+    active_ = true;
+  }
+
+  ~ImporterDatabaseTransaction() { Rollback(); }
+
+  bool Commit() {
+    if (!active_) {
+      return true;
+    }
+    try {
+      database_.EndTransaction();
+      active_ = false;
+      return true;
+    } catch (const std::exception& error) {
+      LOG(ERROR) << "EasySplat matches_importer could not commit its database "
+                    "transaction: "
+                 << error.what();
+      return false;
+    }
+  }
+
+  bool Rollback() noexcept {
+    if (!active_) {
+      return true;
+    }
+    active_ = false;
+    try {
+      database_.RollbackTransaction();
+      return true;
+    } catch (const std::exception& error) {
+      LOG(ERROR) << "EasySplat matches_importer could not roll back its "
+                    "database transaction: "
+                 << error.what();
+      return false;
+    }
+  }
+
+ private:
+  Database& database_;
+  bool active_ = false;
+};
+
+bool MatchingResultsAreEmpty(const Database& database) {
+  const size_t raw_pair_count = database.NumMatchedImagePairs();
+  const size_t verified_pair_count = database.NumVerifiedImagePairs();
+  if (raw_pair_count == 0 && verified_pair_count == 0) {
+    return true;
+  }
+  LOG(ERROR) << "EasySplat matches_importer requires both matching result "
+                "tables to be empty, but found "
+             << raw_pair_count << " matches row(s) and " << verified_pair_count
+             << " two_view_geometries row(s).";
+  return false;
+}

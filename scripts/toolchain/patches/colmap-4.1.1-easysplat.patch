+class MatchListStream {
+ public:
+  MatchListStream(const std::filesystem::path& path, bool strict)
+      : strict_(strict) {
+    if (strict_) {
+      descriptor_ =
+          open(path.string().c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    } else {
+      stream_.open(path);
+    }
+  }
+
+  ~MatchListStream() {
+    if (descriptor_ >= 0) {
+      close(descriptor_);
+    }
+  }
+
+  bool is_open() const {
+    return strict_ ? descriptor_ >= 0 : stream_.is_open();
+  }
+
+  bool ReadLine(std::string* line) {
+    if (!strict_) {
+      return static_cast<bool>(std::getline(stream_, *line));
+    }
+    while (true) {
+      const size_t newline = buffer_.find('\n');
+      if (newline != std::string::npos) {
+        *line = buffer_.substr(0, newline);
+        buffer_.erase(0, newline + 1);
+        return true;
+      }
+      if (reached_eof_) {
+        if (buffer_.empty()) {
+          return false;
+        }
+        *line = std::move(buffer_);
+        buffer_.clear();
+        return true;
+      }
+      char chunk[4096];
+      ssize_t count;
+      do {
+        count = read(descriptor_, chunk, sizeof(chunk));
+      } while (count < 0 && errno == EINTR);
+      if (count < 0) {
+        read_error_ = true;
+        return false;
+      }
+      if (count == 0) {
+        reached_eof_ = true;
+        continue;
+      }
+      buffer_.append(chunk, static_cast<size_t>(count));
+      if (buffer_.size() > 4096 && buffer_.find('\n') == std::string::npos) {
+        read_error_ = true;
+        return false;
+      }
+    }
+  }
+
+  bool bad() const { return strict_ ? read_error_ : stream_.bad(); }
+
+ private:
+  const bool strict_;
+  int descriptor_ = -1;
+  std::ifstream stream_;
+  std::string buffer_;
+  bool reached_eof_ = false;
+  bool read_error_ = false;
+};
+
+bool ParsePoint2DIndex(const std::string& token, point2D_t* index) {
+  if (token.empty()) {
+    return false;
+  }
+  point2D_t parsed = 0;
+  const auto result =
+      std::from_chars(token.data(), token.data() + token.size(), parsed);
+  if (result.ec != std::errc() || result.ptr != token.data() + token.size()) {
+    return false;
+  }
+  *index = parsed;
+  return true;
+}

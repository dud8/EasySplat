            },
            "required": ["input_topology"]
          },
          "then": {
            "properties": {
              "ba_global_frames_ratio": {"const": 1.4},
              "ba_global_points_ratio": {"const": 1.4},
              "ba_local_max_refinements": {"const": 2}
            }
          }
        }
      ]
    }

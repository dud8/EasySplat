        "trainer_iterations": {"enum": [3000, 7000]},
        "trainer_plateau_window": {"enum": [400, 800]},
        "feature_extraction_workers": {"type": "integer", "minimum": 1, "maximum": 64},
        "coupled_matching_workers": {"type": "integer", "minimum": 1, "maximum": 64},
        "vocabulary_retrieval_workers": {"type": "integer", "minimum": 1, "maximum": 64},
        "maximum_concurrent_video_source_analysis_tasks": {"type": "integer", "minimum": 1, "maximum": 64},
        "run_seed": {"const": 42}
      },
      "allOf": [
        {
          "if": {
            "properties": {"input_topology": {"const": "continuous"}},
            "required": ["input_topology"]
          },
          "then": {
            "properties": {
              "ba_global_frames_ratio": {"const": 4.0},
              "ba_global_points_ratio": {"const": 4.0},
              "ba_local_max_refinements": {"const": 1}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dud8/EasySplat/blob/main/scripts/benchmark/evidence.schema.json",
  "title": "EasySplat protected benchmark attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding",
    "baseline_run_configuration",
    "candidate_run_configuration",
    "category",
    "capture_traits",
    "holdout_indices",
    "reference_artifacts",
    "timing_basis",
    "expected_outcome",
    "input_kind",
    "video_source_count",
    "gate_scopes",
    "rendering_driver_identity",
    "scoring_runtime",
    "lane",
    "machine",
    "producer",
    "measurement_runner",
    "commands",
    "resolved_compute",
    "actual",
    "metrics",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 13},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "scene_id",
        "scale",
        "lane",
        "input_digest",
        "corpus_digest",
        "thresholds_digest",
        "git_commit",
        "app_version",
        "toolchain_identity",
        "baseline_git_commit",
        "baseline_toolchain_identity",
        "baseline_configuration_digest",
        "benchmark_contract_sha256"
      ],
      "properties": {
        "profile": {"const": "release"},
        "scene_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
        "scale": {"enum": [30, 120, 250, 500, 3000]},
        "lane": {"enum": ["reference_m4_max", "constrained_14_16gb", "eight_gb_fast"]},
        "input_digest": {"$ref": "#/$defs/sha256"},
        "corpus_digest": {"$ref": "#/$defs/sha256"},
        "thresholds_digest": {"$ref": "#/$defs/sha256"},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "app_version": {"const": "0.2.0"},
        "toolchain_identity": {"$ref": "#/$defs/sha256"},
        "baseline_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "baseline_toolchain_identity": {"$ref": "#/$defs/sha256"},
        "baseline_configuration_digest": {"$ref": "#/$defs/sha256"},
        "benchmark_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "baseline_run_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detail_profile",
        "selected_frame_count",
        "geometry_route",
        "feature_type",
        "feature_max_image_size",
        "feature_max_count",
        "descriptor_matcher",
        "maximum_match_count",
        "matcher_threads",
        "sequential_overlap",
        "exhaustive_block_size",
        "mapper",
        "bundle_adjustment_max_iterations",
        "ba_global_frames_ratio",
        "ba_global_points_ratio",
        "ba_global_max_refinements",
        "ba_local_max_refinements",
        "trainer",
        "trainer_iterations",
        "trainer_plateau_window",
        "run_seed"
      ],
      "properties": {
        "detail_profile": {"const": "balanced"},
        "selected_frame_count": {"const": "request_scale"},
        "geometry_route": {"const": "colmap"},
        "feature_type": {"const": "sift"},
        "feature_max_image_size": {"const": 1024},
        "feature_max_count": {"const": 10000},
        "descriptor_matcher": {"const": "exact_cpu_brute_force"},
        "maximum_match_count": {"const": 10000},
        "matcher_threads": {"const": 8},
        "sequential_overlap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["automatic", "orbit", "walkthrough", "large_area"],
          "properties": {
            "automatic": {"const": 8},
            "orbit": {"const": 8},
            "walkthrough": {"const": 8},
            "large_area": {"const": 16}
          }
        },
        "exhaustive_block_size": {"const": 25},
        "mapper": {"const": "incremental"},
        "bundle_adjustment_max_iterations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["automatic", "orbit", "walkthrough", "large_area"],
          "properties": {
            "automatic": {"const": 75},
            "orbit": {"const": 75},
            "walkthrough": {"const": 75},
            "large_area": {"const": 94}
          }
        },
        "ba_global_frames_ratio": {"const": 1.1},
        "ba_global_points_ratio": {"const": 1.1},
        "ba_global_max_refinements": {"const": 5},
        "ba_local_max_refinements": {"const": 2},
        "trainer": {"const": "native_msplat"},
        "trainer_iterations": {"const": 7000},
        "trainer_plateau_window": {"const": 800},
        "run_seed": {"const": 42}
      }
    },
    "candidate_run_configuration": {"$ref": "#/$defs/candidateRunConfiguration"},
    "category": {
      "enum": [
        "object_orbit",
        "interior_walkthrough",
        "professional_photos",
        "large_area_exterior",
        "low_light",
        "invalid"
      ]
    },
    "capture_traits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"}
    },
    "holdout_indices": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "reference_artifacts": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selection_manifest_sha256",
            "geometry_input_digest",
            "selected_frames_digests",
            "ground_truth_poses_sha256",
            "accurate_colmap_model_sha256",
            "accurate_rendering_reference_sha256",
            "ground_truth_preparation_sha256",
            "paired_baseline_rendering_reference_sha256",
            "orientation_label_sha256",
            "orientation_expected_status"
          ],
          "properties": {
            "selection_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "geometry_input_digest": {"$ref": "#/$defs/sha256"},
            "selected_frames_digests": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate", "fast_candidate"],
              "properties": {
                "candidate": {"$ref": "#/$defs/sha256"},
                "fast_candidate": {"$ref": "#/$defs/sha256"}
              }
            },
            "ground_truth_poses_sha256": {"$ref": "#/$defs/sha256"},
            "accurate_colmap_model_sha256": {"$ref": "#/$defs/sha256"},
            "accurate_rendering_reference_sha256": {"$ref": "#/$defs/sha256"},
            "ground_truth_preparation_sha256": {"$ref": "#/$defs/sha256"},
            "paired_baseline_rendering_reference_sha256": {"$ref": "#/$defs/sha256"},
            "orientation_label_sha256": {"$ref": "#/$defs/sha256"},
            "orientation_expected_status": {
              "enum": ["verified", "axis_aligned_sign_unverified", "unresolved"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"const": "not_applicable"}}
        }
      ]
    },
    "timing_basis": {"const": "selected_view_count"},
    "expected_outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "valid"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "failure_type"],
          "properties": {
            "kind": {"const": "invalid"},
            "failure_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"}
          }
        }
      ]
    },
    "input_kind": {"enum": ["video", "multi_video", "photos", "mixed"]},
    "video_source_count": {"type": "integer", "minimum": 0},
    "gate_scopes": {"$ref": "result.schema.json#/$defs/gateScopes"},
    "rendering_driver_identity": {"$ref": "result.schema.json#/$defs/renderingDriver"},
    "scoring_runtime": {"$ref": "result.schema.json#/$defs/renderScoringRuntime"},
    "lane": {"enum": ["reference_m4_max", "constrained_14_16gb", "eight_gb_fast"]},
    "machine": {"$ref": "result.schema.json#/$defs/machine"},
    "producer": {"$ref": "result.schema.json#/$defs/producer"},
    "measurement_runner": {"$ref": "result.schema.json#/$defs/measurementRunner"},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "phase",
          "variant",
          "argv",
          "mapper_invocations",
          "planned_mapper_cadence",
          "accepted_mapper_cadence",
          "cadence_fallback_trigger",
          "runtime_worker_evidence",
          "started_monotonic_seconds",
          "ended_monotonic_seconds",
          "process_cpu_microseconds",
          "exit_code",
          "checkout_commit",
          "toolchain_identity",
          "run_configuration_digest",
          "executable_sha256",
          "output_sha256",
          "scene_id",
          "input_digest",
          "scale",
          "lane",
          "published_output"
        ],
        "properties": {
          "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
          "phase": {"enum": ["candidate", "ordinary", "phase", "fast_profile", "invalid_input"]},
          "variant": {"enum": ["candidate", "baseline", "fast_candidate", "accurate_reference"]},
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "mapper_invocations": {
            "type": "array",
            "items": {
              "oneOf": [
                {"$ref": "#/$defs/referenceMapperInvocation"},
                {"$ref": "#/$defs/candidateMapperInvocation"}
              ]
            }
          },
          "planned_mapper_cadence": {
            "oneOf": [{"type": "null"}, {"$ref": "#/$defs/mapperCadence"}]
          },
          "accepted_mapper_cadence": {
            "oneOf": [{"type": "null"}, {"$ref": "#/$defs/mapperCadence"}]
          },
          "cadence_fallback_trigger": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/$defs/mappingCadenceFallbackTrigger"}
            ]
          },
          "runtime_worker_evidence": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/$defs/runtimeWorkerEvidence"}
            ]
          },
          "started_monotonic_seconds": {"type": "number", "minimum": 0},
          "ended_monotonic_seconds": {"type": "number", "exclusiveMinimum": 0},
          "process_cpu_microseconds": {
            "type": "object",
            "additionalProperties": false,
            "required": ["user", "system"],
            "properties": {
              "user": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
              "system": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
            }
          },
          "exit_code": {"type": "integer"},
          "checkout_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "toolchain_identity": {"$ref": "#/$defs/sha256"},
          "run_configuration_digest": {"$ref": "#/$defs/sha256"},
          "executable_sha256": {"$ref": "#/$defs/sha256"},
          "output_sha256": {"$ref": "#/$defs/sha256"},
          "scene_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
          "input_digest": {"$ref": "#/$defs/sha256"},
          "scale": {"enum": [30, 120, 250, 500, 3000]},
          "lane": {"enum": ["reference_m4_max", "constrained_14_16gb", "eight_gb_fast"]},
          "published_output": {"type": "boolean"}
        }
      }
    },
    "resolved_compute": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stages", "cpu_only_reasons"],
          "properties": {
            "stages": {
              "type": "object",
              "additionalProperties": false,
              "required": ["feature_extraction", "matching", "mapping", "training", "rendering"],
              "properties": {
                "feature_extraction": {"enum": ["cpu", "metal"]},
                "matching": {"enum": ["cpu", "metal"]},
                "mapping": {"enum": ["cpu", "metal"]},
                "training": {"const": "metal"},
                "rendering": {"const": "metal"}
              }
            },
            "cpu_only_reasons": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "feature_extraction": {"const": "colmap_sift_has_no_supported_metal_backend"},
                "matching": {"const": "faiss_metal_disabled_selected_indices_unsupported"},
                "mapping": {"const": "ceres_has_no_supported_metal_backend"}
              }
            }
          },
          "allOf": [
            {
              "if": {"properties": {"stages": {"properties": {"feature_extraction": {"const": "cpu"}}}}},
              "then": {"properties": {"cpu_only_reasons": {"required": ["feature_extraction"]}}},
              "else": {"properties": {"cpu_only_reasons": {"not": {"required": ["feature_extraction"]}}}}
            },
            {
              "if": {"properties": {"stages": {"properties": {"matching": {"const": "cpu"}}}}},
              "then": {"properties": {"cpu_only_reasons": {"required": ["matching"]}}},
              "else": {"properties": {"cpu_only_reasons": {"not": {"required": ["matching"]}}}}
            },
            {
              "if": {"properties": {"stages": {"properties": {"mapping": {"const": "cpu"}}}}},
              "then": {"properties": {"cpu_only_reasons": {"required": ["mapping"]}}},
              "else": {"properties": {"cpu_only_reasons": {"not": {"required": ["mapping"]}}}}
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"const": "not_applicable"}}
        }
      ]
    },
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "termination_reason", "cancelled", "failure_type", "corrupt_ply"],
      "properties": {
        "exit_code": {"type": ["integer", "null"]},
        "termination_reason": {"enum": ["exit", "signal", "cancelled", "not_available"]},
        "cancelled": {"type": "boolean"},
        "failure_type": {"type": ["string", "null"]},
        "corrupt_ply": {"type": ["boolean", "null"]}
      }
    },
    "photo_permutation": {"$ref": "#/$defs/photoPermutationEvidence"},
    "photo_permutation_execution_receipt": {
      "$ref": "#/$defs/photoPermutationExecutionReceipt"
    },
    "photo_permutation_source_authorization": {
      "$ref": "#/$defs/photoPermutationSourceAuthorization"
    },
    "photo_permutation_supervisor_provenance": {
      "$ref": "#/$defs/photoPermutationSupervisorProvenance"
    },
    "metrics": {"$ref": "result.schema.json#/$defs/metrics"},
    "artifacts": {
      "type": "object",
      "minProperties": 4,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "dependentRequired": {
    "photo_permutation": [
      "photo_permutation_execution_receipt",
      "photo_permutation_source_authorization",
      "photo_permutation_supervisor_provenance"
    ],
    "photo_permutation_execution_receipt": [
      "photo_permutation",
      "photo_permutation_source_authorization",
      "photo_permutation_supervisor_provenance"
    ],
    "photo_permutation_source_authorization": [
      "photo_permutation",
      "photo_permutation_execution_receipt",
      "photo_permutation_supervisor_provenance"
    ],
    "photo_permutation_supervisor_provenance": [
      "photo_permutation",
      "photo_permutation_execution_receipt",
      "photo_permutation_source_authorization"
    ]
  },
  "allOf": [
    {
      "if": {"required": ["photo_permutation"]},
      "then": {
        "properties": {
          "artifacts": {
            "required": [
              "photo_permutation_execution_receipt",
              "photo_permutation_attestation_bundle",
              "photo_permutation_source_authorization",
              "photo_permutation_source_authorization_attestation_bundle"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expected_outcome": {
            "properties": {"kind": {"const": "valid"}},
            "required": ["kind"]
          }
        }
      },
      "then": {
        "properties": {
          "category": {"not": {"const": "invalid"}},
          "gate_scopes": {"not": {"contains": {"const": "invalid_input"}}},
          "holdout_indices": {"minItems": 1},
          "reference_artifacts": {"required": ["selection_manifest_sha256"]},
          "resolved_compute": {"required": ["stages"]},
          "actual": {
            "properties": {
              "exit_code": {"const": 0},
              "termination_reason": {"const": "exit"},
              "cancelled": {"const": false},
              "failure_type": {"type": "null"},
              "corrupt_ply": {"const": false}
            }
          }
        }
      },
      "else": {
        "properties": {
          "category": {"const": "invalid"},
          "gate_scopes": {"const": ["invalid_input"]},
          "holdout_indices": {"maxItems": 0},
          "reference_artifacts": {
            "type": "object",
            "required": ["status"],
            "properties": {"status": {"const": "not_applicable"}}
          },
          "resolved_compute": {
            "type": "object",
            "required": ["status"],
            "properties": {"status": {"const": "not_applicable"}}
          },
          "actual": {
            "properties": {
              "exit_code": {"type": "integer", "not": {"const": 0}},
              "termination_reason": {"const": "exit"},
              "cancelled": {"const": false},
              "failure_type": {"type": "string"},
              "corrupt_ply": {"const": false}
            }
          },
          "artifacts": {"not": {"required": ["output_ply"]}}
        }
      }
    },
    {
      "if": {
        "properties": {"lane": {"const": "reference_m4_max"}},
        "required": ["lane"]
      },
      "then": {
        "properties": {
          "candidate_run_configuration": {
            "properties": {
              "feature_extraction_workers": {"const": 12},
              "coupled_matching_workers": {"const": 8},
              "vocabulary_retrieval_workers": {"const": 8}
            }
          }
        }
      },
      "else": {
        "properties": {
          "candidate_run_configuration": {
            "properties": {
              "feature_extraction_workers": {"const": 4},
              "coupled_matching_workers": {"const": 4},
              "vocabulary_retrieval_workers": {"const": 4}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"input_kind": {"const": "photos"}},
        "required": ["input_kind"]
      },
      "then": {
        "properties": {
          "video_source_count": {"const": 0},
          "candidate_run_configuration": {
            "properties": {"maximum_concurrent_video_source_analysis_tasks": {"const": 1}}
          }
        }
      },
      "else": {
        "if": {
          "properties": {"lane": {"const": "reference_m4_max"}},
          "required": ["lane"]
        },
        "then": {
          "properties": {
            "candidate_run_configuration": {
              "properties": {"maximum_concurrent_video_source_analysis_tasks": {"const": 4}}
            }
          }
        },
        "else": {
          "properties": {
            "candidate_run_configuration": {
              "properties": {"maximum_concurrent_video_source_analysis_tasks": {"const": 2}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"input_kind": {"const": "video"}},
        "required": ["input_kind"]
      },
      "then": {"properties": {"video_source_count": {"const": 1}}}
    },
    {
      "if": {
        "properties": {"input_kind": {"const": "multi_video"}},
        "required": ["input_kind"]
      },
      "then": {"properties": {"video_source_count": {"minimum": 2}}}
    },
    {
      "if": {
        "properties": {"input_kind": {"const": "mixed"}},
        "required": ["input_kind"]
      },
      "then": {"properties": {"video_source_count": {"minimum": 1}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "opaqueSha256": {
      "type": "string",
      "pattern": "^opaque-sha256:[0-9a-f]{64}$"
    },
    "photoPermutationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mode",
        "expected_variant_count",
        "closure_claims",
        "variants",
        "execution_provenance"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "mode": {"enum": ["release", "development"]},
        "expected_variant_count": {"type": "integer", "minimum": 2, "maximum": 100},
        "closure_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {"const": "order_mechanics"},
          "items": {
            "enum": ["order_mechanics", "professional_photo", "raw_camera_metadata"]
          }
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/photoPermutationVariant"}
        },
        "execution_provenance": {
          "$ref": "#/$defs/photoPermutationExecutionProvenance"
        }
      }
    },
    "photoPermutationExecutionProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "group_contract_sha256",
        "request_binding_sha256",
        "source_authorization_sha256",
        "source_kind",
        "source_provenance_commitment",
        "trust_boundary",
        "producer_implementation_sha256",
        "adapter_sha256",
        "toolchain_closure_sha256",
        "variant_schedule_sha256",
        "variant_receipts_sha256",
        "execution_receipt_sha256"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "group_contract_sha256": {"$ref": "#/$defs/sha256"},
        "request_binding_sha256": {"$ref": "#/$defs/sha256"},
        "source_authorization_sha256": {"$ref": "#/$defs/sha256"},
        "source_kind": {
          "enum": [
            "native_photos",
            "single_video_derived_stills",
            "multi_video_derived_stills",
            "mixed_derived_stills",
            "calibration_dataset_derived_stills"
          ]
        },
        "source_provenance_commitment": {"$ref": "#/$defs/opaqueSha256"},
        "trust_boundary": {
          "const": "requires_github_artifact_attestation"
        },
        "producer_implementation_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_sha256": {"$ref": "#/$defs/sha256"},
        "toolchain_closure_sha256": {"$ref": "#/$defs/sha256"},
        "variant_schedule_sha256": {"$ref": "#/$defs/sha256"},
        "variant_receipts_sha256": {"$ref": "#/$defs/sha256"},
        "execution_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "photoPermutationExecutionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "group_contract_sha256",
        "request_binding_sha256",
        "source_authorization_sha256",
        "source_kind",
        "source_provenance_commitment",
        "trust_boundary",
        "producer_implementation_sha256",
        "adapter_sha256",
        "toolchain_closure_sha256",
        "variant_schedule_sha256",
        "variant_receipts",
        "variant_receipts_sha256",
        "group_payload_sha256"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {
